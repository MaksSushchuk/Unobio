GEMINI_API_KEY=
GEMINI_MODEL=

# --- Option D: Google Gemini (uses GEMINI_API_KEY / GEMINI_MODEL above, shared with the researcher)
# LLM_PROVIDER=gemini
# LLM_MAX_CONCURRENCY=2         # free tier is rate-limited per minute; 429s wait for Google's retryDelay

# --- Option A: no model (offline development, scripted answers)
LLM_PROVIDER=fake

# --- Option B: company Ollama server (native API; num_ctx is applied per request)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://<ollama-host>:11434
# LLM_MODEL=qwen2.5:14b
# LLM_NUM_CTX=16384
# LLM_MAX_CONCURRENCY=1

# --- Option C: any OpenAI-compatible API (Groq, OpenRouter, OpenAI, vLLM, LM Studio ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=...
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_JSON_MODE=object          # use "object" if the provider rejects json_schema
# LLM_PRICE_IN=0.59             # USD per 1M input tokens  (for cost per run)
# LLM_PRICE_OUT=0.79            # USD per 1M output tokens

# --- Common
# LLM_TIMEOUT=180
# LLM_CACHE=1                   # cache answers in data/cache/llm.sqlite

# ===== app (end-to-end runs: python -m app run / serve) =====
# UNOBIO_RESEARCH=live          # live = public APIs via researcher; fixture = data/fixtures (offline demo)
# UNOBIO_PDF=1                  # writer step (narrative + report.pdf) on every run; 0 = skip

# ===== writer standalone only (python -m writer_agent). In app runs the writer uses the LLM_* model above.
# WRITER_LLM_URL=http://<ollama-host>:11434
# WRITER_LLM_MODEL=llama3.1:8b
# WRITER_LLM_TIMEOUT=180
